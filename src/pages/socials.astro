---
import BaseLayout from "../layouts/BaseLayout.astro";
const title = "SoftSin Studios — Socials";
const description = "Follow SoftSin Studios artwork, creator tools, project updates, support links, and community posts.";
---
<BaseLayout title={title} description={description} active="socials" pageStyles={["/css/socials.css"]}>
  <section class="hero">
    <div>
      <span class="eyebrow">Socials Links</span>
      <h1>Follow the work, the tools, and the experiments.</h1>
      <p class="lead">SoftSinStudios.com is the main hub for tools, release notes, support, and documentation. Social links are for the public-facing side of the project: finished renders, gallery posts, smaller updates, experiments, and ways to support future work.</p>
      <p class="lead">DeviantArt is the main gallery, Facebook is for broader public updates, Ko-fi is the direct support option, and the Message Board is the official place for release notes, support, and tool discussion.</p>
    </div>
    <aside class="visual-card"><img class="visual social-hero-image" src="/images/socialhero.png" alt="SoftSin Studios social links hero graphic" loading="lazy" /></aside>
  </section>
  <div class="split">
    <section class="panel">
      <div class="panel-head"><h2>About</h2><p>Solo-built creator tools, rendered work, and workflow experiments.</p></div>
      <div class="bio">
        <p>SoftSin Studios is a solo creative project focused on practical tools for AI art, pose control, prompt structure, ComfyUI workflows, rendered images, and music-adjacent creative experiments.</p>
        <p>The goal is simple: build tools that remove friction instead of adding another blinking cockpit to the pile. If a tool helps with pose construction, prompt cleanup, metadata, posting, or repeatable workflow structure, it belongs here.</p>
        <div class="facts">
          <div class="fact"><span>Focus</span><span>AI art tools, pose control, and prompts</span></div>
          <div class="fact"><span>Style</span><span>Dark, cinematic, practical, and creator-focused</span></div>
          <div class="fact"><span>Built By</span><span>One developer handling the tools, site, and art</span></div>
        </div>
      </div>
    </section>
    <section class="panel" id="socials">
      <div class="panel-head"><h2>Socials</h2><p>Ordered by current importance</p></div>
      <div class="socials">
        <a class="social" href="https://www.deviantart.com/softsinstudios" target="_blank" rel="noopener noreferrer"><span class="icon green">DA</span><span><strong>DeviantArt</strong><span>Main gallery for finished renders and art posts</span></span><span class="arrow">↗</span></a>
        <a class="social" href="/board.html"><span class="icon red">MB</span><span><strong>Message Board</strong><span>Official release notes, support, roadmap posts, and tool discussion</span></span><span class="arrow">↗</span></a>
        <a class="social" href="https://www.facebook.com/softsinstudios" target="_blank" rel="noopener noreferrer"><span class="icon">FB</span><span><strong>Facebook</strong><span>Public announcements, updates, and broader community posts</span></span><span class="arrow">↗</span></a>
        <a class="social" href="https://ko-fi.com/softsinstudios" target="_blank" rel="noopener noreferrer"><span class="icon orange">KF</span><span><strong>Ko-fi / Support</strong><span>Direct support for continued tool development and site work</span></span><span class="arrow">↗</span></a>
      </div>
    </section>
  </div>
</BaseLayout>
