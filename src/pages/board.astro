---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="SoftSin Studios — Message Board"
  description="SoftSin Studios message board for release notes, support, roadmap posts, known issues, and tool discussion."
  active="board"
  canonicalPath="/board.html"
  bodyClass="board-page"
  pageStyles={["/css/board.css"]}
>
    <div class="board">
      <aside class="sidebar">
        <section class="side-section account-card">
          <div class="side-title">Account</div>

          <div id="signedOutBox">
            <p class="account-note">Sign in to create topics and reply.</p>
            <button class="btn primary full board-signin-button" id="openSignIn" type="button">Sign In</button>
          </div>

          <div id="signedInBox" hidden>
            <div class="user-row">
              <img id="userAvatar" class="user-avatar" alt="" />
              <div>
                <strong id="userName">Signed in</strong>
                <span id="userRole">member</span>
              </div>
            </div>

            <div class="account-actions">
              <a class="btn full" href="profile.html">Profile</a>
              <button class="btn full" id="logout" type="button">Sign out</button>
            </div>
          </div>
        </section>

        <section class="side-section">
          <div class="side-title">Channels</div>
          <div id="categoryList">
            <a class="channel active" href="#" data-slug="general"><span>General</span><span class="pill">0</span></a>
            <a class="channel" href="#" data-slug="pose-editor"><span>Pose Editor</span><span class="pill">0</span></a>
            <a class="channel" href="#" data-slug="release-notes"><span>Release Notes</span><span class="pill">0</span></a>
            <a class="channel" href="#" data-slug="json-maker"><span>JSON Maker</span><span class="pill">0</span></a>
            <a class="channel" href="#" data-slug="comfyui-nodes"><span>ComfyUI Nodes</span><span class="pill">0</span></a>
            <a class="channel" href="#" data-slug="sd-prompt-composer"><span>SD Prompt Composer</span><span class="pill">0</span></a>
            <a class="channel" href="#" data-slug="showcase"><span>Showcase</span><span class="pill">0</span></a>
            <a class="channel" href="#" data-slug="known-issues"><span>Known Issues</span><span class="pill">0</span></a>
            <a class="channel" href="#" data-slug="roadmap"><span>Roadmap</span><span class="pill">0</span></a>
            <a class="channel" href="#" data-slug="support-issues"><span>Support Issues</span><span class="pill">0</span></a>
          </div>
        </section>

        <section class="side-section">
          <div class="side-title">Quick Links</div>
          <a class="channel" href="#" id="rulesLink"><span>Rules</span></a>
          <a class="channel moderation-queue-link" href="#" id="moderationQueueLink" hidden>
            <span>Moderation Queue</span><span class="pill" id="openReportCount">0</span>
          </a>
        </section>
      </aside>

      <section class="main-panel">
        <nav class="board-breadcrumbs" id="boardBreadcrumbs" aria-label="Board navigation">
          <a href="/board.html" data-board-home>Message Board</a>
          <span aria-hidden="true">/</span>
          <button type="button" id="breadcrumbCategory">General</button>
          <span id="breadcrumbThreadSeparator" aria-hidden="true" hidden>/</span>
          <span id="breadcrumbThread" hidden></span>
        </nav>
        <div class="panel-head">
          <div>
            <h2 id="boardTitle">General</h2>
            <p id="boardSubtitle">Public discussion for the SoftSin Studios ecosystem.</p>
          </div>
          <div class="panel-head-actions">
            <input class="search" type="search" placeholder="Search threads..." />
            <button class="btn action board-new-topic" id="newTopicTop" type="button" disabled>New Topic</button>
          </div>
        </div>

        <div class="thread-list" id="threadList">
          <article class="thread">
            <div class="avatar">SS</div>
            <div>
              <h3>Board frontend wiring starts here</h3>
              <p>This static placeholder confirms the layout. Real threads will be loaded from Supabase next.</p>
              <span class="tag good">Pinned</span>
            </div>
            <div class="meta">0 replies<br>Today</div>
          </article>
        </div>

        <div class="rules-reminder" id="rulesReminder">
          <span>Before posting, skim the board rules so the workshop stays clean.</span>
          <button class="btn" id="openRulesReminder" type="button">Read Rules</button>
        </div>

        <div id="composerDock" aria-hidden="true"></div>
        <form class="composer" id="composer" hidden>
          <input
            id="composerTitle"
            class="composer-title"
            type="text"
            placeholder="Thread title"
            maxlength="140"
            disabled
          />

          <div class="editor-toolbar" id="editorToolbar" aria-label="Text editor toolbar">
            <button class="editor-tool" type="button" data-editor-action="bold" title="Bold selected text"><strong>B</strong></button>
            <button class="editor-tool" type="button" data-editor-action="italic" title="Italicize selected text"><em>I</em></button>
            <button class="editor-tool" type="button" data-editor-action="h2" title="Add a section heading">H2</button>
            <button class="editor-tool" type="button" data-editor-action="h3" title="Add a smaller heading">H3</button>
            <button class="editor-tool" type="button" data-editor-action="code" title="Format inline code">Inline Code</button>
            <button class="editor-tool" type="button" data-editor-action="codeblock" title="Format a code block">Code Block</button>
            <button class="editor-tool" type="button" data-editor-action="quote" title="Format a quotation">Quote</button>
            <button class="editor-tool" type="button" data-editor-action="ul" title="Create a bulleted list">• List</button>
            <button class="editor-tool" type="button" data-editor-action="ol" title="Create a numbered list">1. List</button>
            <button class="editor-tool" type="button" data-editor-action="divider" title="Insert a divider">Divider</button>
            <button class="editor-tool" type="button" data-editor-action="link" title="Insert a safe web link">Link</button>
            <button class="editor-tool" type="button" data-editor-action="image" title="Upload an image">Upload Image</button>
            <button class="editor-tool editor-template-toggle" id="editorTemplatePicker" type="button" hidden>Templates</button>
            <button class="editor-tool editor-preview-toggle" id="editorPreviewToggle" type="button">Preview</button>
            <span class="editor-count" id="editorCharCount">0 / 20000</span>
          </div>

          <textarea id="composerText" placeholder="Sign in to post..." maxlength="20000" disabled></textarea>
          <input id="boardImageInput" type="file" accept="image/png,image/jpeg,image/webp,image/gif" hidden />
          <div class="editor-preview markdown-body" id="editorPreview" hidden></div>

          <div class="composer-actions">
            <span class="tiny" id="composerStatus">Read freely. Sign in to post or reply.</span>
            <button class="btn primary" id="postMessage" type="button" disabled>Create Thread</button>
          </div>
        </form>

        <div class="board-modal topic-modal" id="topicModal" hidden aria-labelledby="topicModalTitle" role="dialog" aria-modal="true">
          <div class="board-modal-card topic-modal-card" role="document">
            <div class="topic-modal-head">
              <div>
                <span class="side-title">New discussion</span>
                <h3 id="topicModalTitle">Create a topic</h3>
                <p id="topicModalChannel">Choose a clear title and give readers enough context to respond.</p>
              </div>
              <button class="btn neutral topic-modal-close" id="closeTopicModal" type="button">Close</button>
            </div>
            <div id="topicComposerMount"></div>
          </div>
        </div>

        <div class="board-modal template-modal" id="templateModal" hidden aria-labelledby="templateModalTitle" role="dialog" aria-modal="true">
          <div class="board-modal-card template-modal-card" role="document">
            <div class="template-modal-head">
              <div>
                <span class="side-title">Post templates</span>
                <h3 id="templateModalTitle">Choose a template</h3>
                <p>Pick a saved format, preview it, then drop it into the composer.</p>
              </div>
              <button class="editor-tool template-close-button" id="closeTemplateModal" type="button" aria-label="Close template picker">Close</button>
            </div>

            <div class="template-modal-grid">
              <div class="template-list" id="templateList" aria-label="Available post templates">
                <div class="template-empty">Loading templates...</div>
              </div>

              <div class="template-preview-panel">
                <label for="templatePreviewTitle">Title</label>
                <input id="templatePreviewTitle" type="text" readonly value="Select a template" />

                <label for="templatePreviewBody">Body</label>
                <textarea id="templatePreviewBody" readonly>Select a template to preview its post body.</textarea>
              </div>
            </div>

            <div class="board-modal-actions">
              <button class="btn" id="cancelTemplateInsert" type="button">Cancel</button>
              <button class="btn primary" id="insertTemplate" type="button" disabled>Insert Template</button>
            </div>
          </div>
        </div>

        <div class="board-modal signin-modal" id="signInModal" hidden aria-labelledby="signInModalTitle" role="dialog" aria-modal="true">
          <div class="board-modal-card signin-modal-card" role="document">
            <div class="signin-modal-head">
              <div>
                <span class="side-title">SoftSin Community</span>
                <h3 id="signInModalTitle">Sign in</h3>
                <p>Choose the account you want to use.</p>
              </div>
              <button class="editor-tool" id="closeSignInModal" type="button" aria-label="Close sign-in dialog">Close</button>
            </div>
            <div class="auth-options" aria-label="Sign in options">
              <button class="btn full auth-provider-btn discord-login" id="loginDiscord" type="button">
                <span class="auth-provider-icon discord-mark" aria-hidden="true">D</span>
                <span>Continue with Discord</span>
              </button>
              <button class="btn full auth-provider-btn google-login" id="loginGoogle" type="button">
                <span class="auth-provider-icon google-mark" aria-hidden="true">G</span>
                <span>Continue with Google</span>
              </button>
            </div>
          </div>
        </div>

        <div class="board-modal report-modal" id="reportModal" hidden aria-labelledby="reportModalTitle" role="dialog" aria-modal="true">
          <div class="board-modal-card report-modal-card" role="document">
            <div class="topic-modal-head">
              <div>
                <span class="side-title">Community safety</span>
                <h3 id="reportModalTitle">Report content</h3>
                <p id="reportTargetSummary">Tell the moderation team what needs attention.</p>
              </div>
              <button class="btn neutral" id="closeReportModal" type="button">Close</button>
            </div>

            <form id="reportForm">
              <label class="report-label" for="reportReason">Reason</label>
              <select id="reportReason" required>
                <option value="">Choose a reason</option>
                <option value="spam">Spam or promotion</option>
                <option value="harassment">Harassment or targeted abuse</option>
                <option value="illegal">Illegal or exploitative content</option>
                <option value="impersonation">Impersonation or identity abuse</option>
                <option value="misinformation">Dangerous misinformation</option>
                <option value="off-topic">Off-topic or disruptive</option>
                <option value="other">Other</option>
              </select>

              <label class="report-label" for="reportDetails">Details <span>optional</span></label>
              <textarea id="reportDetails" maxlength="2000" placeholder="Give moderators the context they need. Do not include passwords or private credentials."></textarea>
              <div class="report-form-footer">
                <span class="tiny" id="reportStatus">Reports are private and visible only to you and the moderation team.</span>
                <button class="btn primary" id="submitReport" type="submit">Submit Report</button>
              </div>
            </form>
          </div>
        </div>
      </section>
    </div>

  <script src="../scripts/board.js"></script>
</BaseLayout>
